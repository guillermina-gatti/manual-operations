generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Each team adds its own models in its own PR, following the table contract
// (team A: users, areas, ...; team B: procedures, ...; team C: documents, chunks, ...).
// The vector extension is already created by docker/postgres/init.sql.