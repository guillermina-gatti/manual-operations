{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "prisma generate && nest build",
        "dev": "prisma generate && nest start --watch",
        "start:prod": "prisma migrate deploy && node dist/main.js",
        "lint": "prisma generate && tsc --noEmit",
        "test": "jest --passWithNoTests",
        "migrate:dev": "prisma migrate dev",
        "studio": "prisma studio"
    },
    "dependencies": {
        "@ai-sdk/google": "^2.0.0",
        "@nestjs/bullmq": "^11",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.0.0",
        "@prisma/client": "^6.0.0",
        "ai": "^5.0.0",
        "bullmq": "^5.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "ioredis": "^5.4.0",
        "pdf-parse": "1.1.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^22.0.0",
        "@types/pdf-parse": "^1.1.5",
        "@types/supertest": "^6.0.0",
        "jest": "^29.7.0",
        "prisma": "^6.0.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    }
}