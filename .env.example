# Copy to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Local database (docker compose)
DATABASE_URL=postgresql://app:app@localhost:5432/manual_ops?schema=public

# Local Redis (docker compose), used by BullMQ
REDIS_URL=redis://localhost:6379

# Gemini (read by @ai-sdk/google by default)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001